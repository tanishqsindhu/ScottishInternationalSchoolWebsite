<% layout('layouts/boilerplate')%>
<section class="brand-hero row" style="overflow-x: hidden">
	<div class="animate-banner">
		<picture class="zoom">
			<div
				id="carouselExampleSlidesOnly"
				class="carousel slide carousel-fade"
				data-bs-ride="carousel"
				data-bs-pause="false"
			>
				<div class="carousel-inner">
					<div class="carousel-item active" data-bs-interval="3000">
						<img
							src="https://res.cloudinary.com/djfy7fvq1/image/upload//w_1500/q_auto/f_auto/v1683454348/Screenshot_2023-05-07_at_3.41.47_PM_wt8wpn.png"
							class="d-block w-100"
							alt="School Building"
							style="height: 70vh"
						/>
						<!-- <div class="carousel-caption d-none d-md-block">
                            <h5>First slide label</h5>
                            <p>Some representative placeholder content for the first slide.</p>
                        </div> -->
					</div>
					<div class="carousel-item" data-bs-interval="3000">
						<img
							src="https://res.cloudinary.com/djfy7fvq1/image/upload//w_1500/q_auto/f_auto/v1679174855/Scottish/qd8pkstxjoq0udwuwoc7.jpg"
							class="d-block w-100"
							alt="School Building"
							style="height: 70vh"
						/>
						<!-- <div class="carousel-caption d-none d-md-block">
                            <h5>First slide label</h5>
                            <p>Some representative placeholder content for the first slide.</p>
                        </div> -->
					</div>
				</div>
			</div>
		</picture>
	</div>
	<div class="page-title align-items-start">
		<div class="container">
			<div class="banner-content-inner">
				<h1>
					Beyond Classroom
					<a href="/"><i class="fa-solid fa-arrow-left" style="color: #eabd57"></i> Home</a>
				</h1>
			</div>
		</div>
	</div>
</section>
<div class="container-fuild">
	<div class="row">
		<section class="inner-entry">
			<div
				class="container wow fadeInUp"
				data-wow-duration="1.5s"
				data-wow-delay=".2s"
				style="
					visibility: visible;
					animation-duration: 1.5s;
					animation-delay: 0.2s;
					animation-name: fadeInUp;
				"
			>
				<div class="mainTitle">
					<p class="title-branding mb-2">
						<img class="img-fluid" src="/assets/webp/SISTransparentLogoWhite.webp" alt="Logo" />
					</p>
					<h2></h2>
				</div>
			</div>
		</section>
	</div>
</div>
<section class="container pt-3 bg-1" data-aos="fade-up">
	<div class="row justify-content-center">
		<h2 class="text-center display-1 py-5" style="color: #654f4f">
			WHERE YOU WANT TO VISIT FIRST?
		</h2>
		<div class="col-md-6 mb-2">
			<a href="/beyond-classroom/sports">
				<div class="card">
					<img src="/assets/webp/basketball.webp" class="card-img" height="750px" />
					<div class="card-img-overlay align-content-center">
						<h5
							class="card-title text-center display-3 rounded"
							style="color: #eabd57; background-color: rgba(46, 46, 46, 0.4)"
						>
							Sports
						</h5>
						<!-- <p class="card-text">This is a wider card with supporting text below as a natural
                                    lead-in to additional content. This content is a little bit longer.</p>
                                <p class="card-text"><small>Last updated 3 mins ago</small></p> -->
					</div>
				</div>
			</a>
		</div>
		<div class="col-md-6">
			<a href="/beyond-classroom/co-curricular">
				<div class="card">
					<img
						src="/assets/webp/Glimpse of Baisakhi Celebration.webp"
						class="card-img"
						height="750px"
					/>
					<div class="card-img-overlay align-content-center">
						<h5
							class="card-title text-center display-3 rounded"
							style="color: #eabd57; background-color: rgba(46, 46, 46, 0.4)"
						>
							Co-Currucular
						</h5>
						<!-- <p class="card-text">This is a wider card with supporting text below as a natural
                                    lead-in to additional content. This content is a little bit longer.</p>
                                <p class="card-text"><small>Last updated 3 mins ago</small></p> -->
					</div>
				</div>
			</a>
		</div>
	</div>
</section>
<style>
	@keyframes zoominoutsinglefeatured {
		0% {
			transform: scale(1, 1);
		}

		100% {
			transform: scale(1.25, 1.25);
		}
	}

	.card:hover {
		animation: zoominoutsinglefeatured 20s infinite;
	}
</style>
<link rel="stylesheet" href="/stylesheets/page-title.css" />
