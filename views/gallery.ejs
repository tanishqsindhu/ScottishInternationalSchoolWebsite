<% layout('layouts/boilerplate')%>
	<section id="top" style="overflow: hidden" class="brand-hero row">
		<!--<iframe class="google-map" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3444.1434557992666!2d78.05572211552051!3d30.3184371125311!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390929b7249d5e1f%3A0x6a0dbc429180e02b!2sWelham%20Boys&#39;%20School!5e0!3m2!1sen!2sin!4v1594274963609!5m2!1sen!2sin"  frameborder="0" style="border:0;" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>-->
		<div class="animate-banner">
			<picture class="zoom">
				<div id="carouselExampleSlidesOnly" class="carousel slide carousel-fade" data-bs-ride="carousel"
					data-bs-pause="false">
					<div class="carousel-inner">
						<div class="carousel-item active" data-bs-interval="3000">
							<img src="https://res.cloudinary.com/djfy7fvq1/image/upload/w_1500/f_auto,q_auto/v1/Scottish/me8akbjwzvyuzno4e6zf"
								class="d-block w-100" alt="School Building" style="height: 70vh" />
							<!-- <div class="carousel-caption d-none d-md-block">
								<h5>First slide label</h5>
								<p>Some representative placeholder content for the first slide.</p>
							</div> -->
						</div>
						<div class="carousel-item" data-bs-interval="3000">
							<img src="https://res.cloudinary.com/djfy7fvq1/image/upload/w_1500/q_auto/f_auto/v1741596937/naqc1fiijnhbap3jmyr8.webp"
								class="d-block w-100" alt="School Building" style="height: 70vh" />
							<!-- <div class="carousel-caption d-none d-md-block">
								<h5>First slide label</h5>
								<p>Some representative placeholder content for the first slide.</p>
							</div> -->
						</div>
					</div>
				</div>
			</picture>
		</div>
		<%- include('./partials/flash')%>
			<div class="page-title align-items-start">
				<div class="container">
					<div class="banner-content-inner">
						<h1>
							Gallery
							<a href="/"><i class="fa-solid fa-arrow-left" style="color: #eabd57"></i> Home</a>
						</h1>
					</div>
				</div>
			</div>
	</section>
	<svg xmlns="http://www.w3.org/2000/svg" class="d-none">
		<symbol id="info-fill" viewBox="0 0 16 16">
			<path
				d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" />
		</symbol>
	</svg>
	<div class="container mt-5">
		<!-- Social Media Navigation Tabs -->
		<ul class="nav nav-tabs social-tabs mb-4" id="socialTabs" role="tablist">
			<li class="nav-item" role="presentation">
				<button class="nav-link active" id="facebook-tab" data-bs-toggle="tab" data-bs-target="#facebook"
					type="button" role="tab" aria-controls="facebook" aria-selected="true">
					<i class="fa-brands fa-facebook me-2"></i>Facebook
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="youtube-tab" data-bs-toggle="tab" data-bs-target="#youtube" type="button"
					role="tab" aria-controls="youtube" aria-selected="false">
					<i class="fa-brands fa-youtube me-2"></i>YouTube
				</button>
			</li>
		</ul>

		<!-- Tab Content -->
		<div class="tab-content" id="socialTabsContent">
			<!-- Facebook Tab -->
			<div class="tab-pane fade show active" id="facebook" role="tabpanel" aria-labelledby="facebook-tab">
				<div class="row">
					<div class="col-12 text-center mb-4">
						<h2 class="section-title">Our Facebook Updates</h2>
						<p class="lead">Stay connected with our latest announcements and events</p>
					</div>
				</div>
				<% if (typeof posts !== 'undefined' && posts && posts.length > 0) { %>
					<div class="fb-masonry" id="fbPostsGrid">
						<% const PAGE_SIZE = 12; %>
						<% posts.forEach((post, idx) => { %>
							<%
								// Prefer the rich media array; fall back to the legacy single image
								const media = (post.media && post.media.length > 0)
									? post.media
									: (post.image_url ? [{ type: 'photo', src: post.image_url, source: null }] : []);
								const carouselId = `fbPostCarousel${idx}`;
								// Adaptive frame: use the first media item's natural aspect ratio (clamped)
								const first = media[0];
								let ratio = (first && first.width && first.height) ? first.width / first.height : 4 / 3;
								ratio = Math.min(Math.max(ratio, 0.7), 1.9);
								const frameStyle = `aspect-ratio: ${ratio.toFixed(3)};`;
							%>
							<div class="fb-masonry-item <%= idx >= PAGE_SIZE ? 'fb-hidden' : '' %>">
								<div class="card fb-post-card">
									<% if (media.length > 1) { %>
										<!-- Multi-photo/video album: carousel -->
										<div id="<%= carouselId %>" class="carousel slide fb-media-frame" style="<%= frameStyle %>" data-bs-ride="carousel">
											<div class="carousel-indicators">
												<% media.forEach((m, mIdx) => { %>
													<button type="button" data-bs-target="#<%= carouselId %>"
														data-bs-slide-to="<%= mIdx %>" <%- mIdx === 0 ? 'class="active" aria-current="true"' : '' %>
														aria-label="Slide <%= mIdx + 1 %>"></button>
												<% }) %>
											</div>
											<div class="carousel-inner h-100">
												<% media.forEach((m, mIdx) => { %>
													<div class="carousel-item h-100 <%= mIdx === 0 ? 'active' : '' %>" data-bs-interval="4000">
														<% if (m.type === 'video' && m.source) { %>
															<video class="fb-post-media fb-video" muted loop playsinline preload="metadata"
																poster="<%= m.src || '' %>">
																<source src="<%= m.source %>" type="video/mp4" />
															</video>
														<% } else { %>
															<img src="<%= m.src %>" class="fb-post-media"
																alt="<%= post.title || 'Facebook post' %> - photo <%= mIdx + 1 %>" loading="lazy" />
														<% } %>
													</div>
												<% }) %>
											</div>
											<button class="carousel-control-prev" type="button" data-bs-target="#<%= carouselId %>" data-bs-slide="prev">
												<span class="carousel-control-prev-icon" aria-hidden="true"></span>
												<span class="visually-hidden">Previous</span>
											</button>
											<button class="carousel-control-next" type="button" data-bs-target="#<%= carouselId %>" data-bs-slide="next">
												<span class="carousel-control-next-icon" aria-hidden="true"></span>
												<span class="visually-hidden">Next</span>
											</button>
											<span class="fb-media-count"><i class="fa-regular fa-images me-1"></i><%= media.length %></span>
										</div>
									<% } else if (media.length === 1) { %>
										<div class="fb-media-frame" style="<%= frameStyle %>">
											<% const m = media[0]; %>
											<% if (m.type === 'video' && m.source) { %>
												<video class="fb-post-media fb-video" muted loop playsinline preload="metadata"
													poster="<%= m.src || '' %>" controls>
													<source src="<%= m.source %>" type="video/mp4" />
												</video>
												<span class="fb-media-count"><i class="fa-solid fa-video me-1"></i>Video</span>
											<% } else if (m.type === 'video') { %>
												<!-- Video without a playable source: thumbnail with play overlay linking to Facebook -->
												<a href="<%= post.url %>" target="_blank" rel="noopener" class="fb-video-thumb">
													<img src="<%= m.src %>" class="fb-post-media" alt="<%= post.title || 'Facebook video' %>" loading="lazy" />
													<span class="fb-play-overlay"><i class="fa-solid fa-circle-play"></i></span>
												</a>
											<% } else { %>
												<a href="<%= post.url %>" target="_blank" rel="noopener">
													<img src="<%= m.src %>" class="fb-post-media"
														alt="<%= post.title || 'Facebook post' %>" loading="lazy" />
												</a>
											<% } %>
										</div>
									<% } %>
									<div class="card-body d-flex flex-column">
										<% if (post.title) { %>
											<h5 class="card-title"><%= post.title %></h5>
										<% } %>
										<% if (post.message) { %>
											<%
												// Long descriptions: show only the first third, with a link to the full post
												const isLong = post.message.length > 150;
												let shownMessage = post.message;
												if (isLong) {
													const third = Math.ceil(post.message.length / 3);
													const cut = post.message.lastIndexOf(' ', third);
													shownMessage = post.message.slice(0, cut > 0 ? cut : third).trimEnd();
												}
											%>
											<p class="card-text fb-post-message"><%= shownMessage %><% if (isLong) { %>&hellip;
												<a href="<%= post.url %>" target="_blank" rel="noopener" class="fb-show-more">Show more</a><% } %></p>
										<% } %>
										<div class="mt-auto d-flex justify-content-between align-items-center pt-3">
											<small class="text-muted">
												<i class="fa-regular fa-calendar me-1"></i>
												<%= new Date(post.created_time).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
											</small>
											<a href="<%= post.url %>" target="_blank" rel="noopener"
												class="btn btn-sm btn-outline-primary">
												<i class="fa-brands fa-facebook me-1"></i>View Post
											</a>
										</div>
									</div>
								</div>
							</div>
						<% }) %>
					</div>

					<!-- Infinite scroll sentinel: more posts load automatically when this comes into view -->
					<div id="fbScrollSentinel" data-page-size="<%= PAGE_SIZE %>"
						class="text-center py-4 <%= posts.length > PAGE_SIZE ? '' : 'd-none' %>">
						<div class="spinner-border text-secondary" role="status">
							<span class="visually-hidden">Loading more posts...</span>
						</div>
					</div>
				<% } else { %>
					<div class="row">
						<div class="col-12 text-center">
							<p class="text-muted">No posts available at the moment. Please check back later.</p>
						</div>
					</div>
				<% } %>

				<div class="text-center mt-4">
					<a href="https://www.facebook.com/scottishinternationalschoolhisar" target="_blank"
						class="btn btn-primary">
						<i class="fa-brands fa-facebook me-2"></i>Visit Our Facebook Page
					</a>
				</div>
			</div>

			<!-- YouTube Tab -->
			<div class="tab-pane fade" id="youtube" role="tabpanel" aria-labelledby="youtube-tab">
				<div class="row">
					<div class="col-12 text-center mb-4">
						<h2 class="section-title">Our YouTube Channel</h2>
						<p class="lead">Watch videos from our school events and activities</p>
					</div>
				</div>
				<div class="row">
					<div class="col-lg-8 mx-auto">
						<div class="youtube-container">
							<iframe width="100%" height="515" src="https://www.youtube.com/embed/3UaVy0B4mBA?si=CUi80jAr7V_8_Ye-" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
						</div>

						<div class="text-center mt-4">
							<a href="https://www.youtube.com/@scottishinternationalhisar" target="_blank"
								class="btn btn-danger">
								<i class="fa-brands fa-youtube me-2"></i>Visit Our YouTube Channel
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<style>
		/* Tab Navigation Styling */
		.social-tabs {
			border-bottom: 1px solid #dee2e6;
			justify-content: center;
		}

		.social-tabs .nav-link {
			margin-bottom: -1px;
			border: 1px solid transparent;
			border-top-left-radius: 0.25rem;
			border-top-right-radius: 0.25rem;
			font-weight: 500;
			padding: 0.75rem 1.5rem;
			transition: all 0.3s ease;
		}

		.social-tabs .nav-link:hover {
			border-color: #e9ecef #e9ecef #dee2e6;
		}

		.social-tabs .nav-link.active {
			color: #495057;
			background-color: #fff;
			border-color: #dee2e6 #dee2e6 #fff;
		}

		/* Masonry layout: JS distributes items into flex columns */
		.fb-masonry {
			display: flex;
			gap: 1.5rem;
			align-items: flex-start;
		}

		.fb-masonry-col {
			flex: 1 1 0;
			min-width: 0;
		}

		.fb-masonry-item {
			margin-bottom: 1.5rem;
		}

		.fb-masonry-item.fb-hidden {
			display: none;
		}

		/* Facebook Post Cards */
		.fb-post-card {
			border: none;
			border-radius: 12px;
			box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
			overflow: hidden;
			transition: transform 0.3s ease, box-shadow 0.3s ease;
		}

		.fb-post-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
		}

		/* Media frame: adaptive aspect ratio (set inline per post) with a dark letterbox background */
		.fb-media-frame {
			position: relative;
			width: 100%;
			aspect-ratio: 4 / 3; /* fallback; overridden inline per post */
			background: #111;
			overflow: hidden;
		}

		.fb-media-frame a {
			display: block;
			width: 100%;
			height: 100%;
		}

		.fb-post-media {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform 0.4s ease;
		}

		.fb-post-card:hover img.fb-post-media {
			transform: scale(1.04);
		}

		/* Videos keep their full frame (no cropping) */
		video.fb-post-media {
			object-fit: contain;
		}

		/* Media count / video badge */
		.fb-media-count {
			position: absolute;
			top: 10px;
			right: 10px;
			background: rgba(0, 0, 0, 0.6);
			color: #fff;
			font-size: 0.75rem;
			padding: 3px 10px;
			border-radius: 20px;
			z-index: 3;
		}

		/* Play overlay for videos without a direct source */
		.fb-video-thumb {
			position: relative;
		}

		.fb-play-overlay {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 3.5rem;
			color: rgba(255, 255, 255, 0.9);
			background: rgba(0, 0, 0, 0.25);
			transition: background 0.3s ease;
		}

		.fb-video-thumb:hover .fb-play-overlay {
			background: rgba(0, 0, 0, 0.45);
		}

		/* Carousel controls: subtle, appear on hover */
		.fb-media-frame .carousel-control-prev,
		.fb-media-frame .carousel-control-next {
			width: 15%;
			opacity: 0;
			transition: opacity 0.3s ease;
		}

		.fb-media-frame:hover .carousel-control-prev,
		.fb-media-frame:hover .carousel-control-next {
			opacity: 0.9;
		}

		/* Touch devices have no hover: keep controls visible */
		@media (hover: none) {
			.fb-media-frame .carousel-control-prev,
			.fb-media-frame .carousel-control-next {
				opacity: 0.8;
			}
		}

		.fb-media-frame .carousel-indicators {
			margin-bottom: 0.5rem;
		}

		.fb-media-frame .carousel-indicators button {
			width: 8px;
			height: 8px;
			border-radius: 50%;
		}

		.fb-post-message {
			color: #555;
			white-space: pre-line; /* keep Facebook line breaks */
			word-break: break-word;
		}

		.fb-show-more {
			color: #1877f2; /* Facebook blue */
			font-weight: 500;
			text-decoration: none;
			white-space: nowrap;
		}

		.fb-show-more:hover {
			text-decoration: underline;
		}

		/* YouTube Container */
		.youtube-container {
			position: relative;
			width: 100%;
			background: white;
			border-radius: 8px;
			box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
			overflow: hidden;
		}

		/* Section Title Styling */
		.section-title {
			position: relative;
			margin-bottom: 1.5rem;
			color: #333;
		}

		.section-title:after {
			content: '';
			display: block;
			width: 80px;
			height: 3px;
			background: #eabd57;
			margin: 15px auto 0;
		}

		@media (max-width: 768px) {
			.social-tabs .nav-link {
				padding: 0.5rem 1rem;
				font-size: 0.9rem;
			}
		}
	</style>

	<script>
		// Autoplay videos only while they are visible on screen
		document.addEventListener('DOMContentLoaded', () => {
			// ---- Video autoplay: play only while visible on screen ----
			const videoObserver = ('IntersectionObserver' in window)
				? new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.play().catch(() => { /* autoplay blocked - ignore */ });
						} else {
							entry.target.pause();
						}
					});
				}, { threshold: 0.4 })
				: null;

			const observeVideos = (root) => {
				if (!videoObserver) return;
				root.querySelectorAll('video.fb-video').forEach((v) => videoObserver.observe(v));
			};

			// ---- Carousels: explicit init with autoplay + pause/play videos on slide ----
			const initCarousels = (root) => {
				root.querySelectorAll('.fb-media-frame.carousel').forEach((el) => {
					if (el.dataset.fbInit) return;
					el.dataset.fbInit = '1';
					if (window.bootstrap?.Carousel) {
						bootstrap.Carousel.getOrCreateInstance(el, { interval: 4000, ride: 'carousel', touch: true, pause: 'hover' });
					}
					el.addEventListener('slid.bs.carousel', () => {
						el.querySelectorAll('video.fb-video').forEach((v) => v.pause());
						const activeVideo = el.querySelector('.carousel-item.active video.fb-video');
						if (activeVideo) activeVideo.play().catch(() => {});
					});
				});
			};

			// ---- Masonry: distribute post cards into flex columns (shortest first) ----
			const grid = document.getElementById('fbPostsGrid');
			if (!grid) return;

			const allItems = Array.from(grid.querySelectorAll('.fb-masonry-item'));
			const sentinel = document.getElementById('fbScrollSentinel');
			const pageSize = parseInt(sentinel?.dataset.pageSize) || 12;
			let visibleCount = Math.min(pageSize, allItems.length);

			const columnCount = () => window.innerWidth < 576 ? 1 : (window.innerWidth < 992 ? 2 : 3);
			let currentCols = 0;
			let cols = [];

			const shortestCol = () => cols.reduce((a, b) => (b.offsetHeight < a.offsetHeight ? b : a), cols[0]);

			const appendItem = (item) => {
				item.classList.remove('fb-hidden');
				shortestCol().appendChild(item);
			};

			const layout = () => {
				currentCols = columnCount();
				grid.textContent = '';
				cols = [];
				for (let i = 0; i < currentCols; i++) {
					const col = document.createElement('div');
					col.className = 'fb-masonry-col';
					grid.appendChild(col);
					cols.push(col);
				}
				for (let i = 0; i < visibleCount; i++) appendItem(allItems[i]);
			};

			const revealMore = () => {
				const next = Math.min(visibleCount + pageSize, allItems.length);
				for (let i = visibleCount; i < next; i++) appendItem(allItems[i]);
				visibleCount = next;
				if (visibleCount >= allItems.length && sentinel) sentinel.classList.add('d-none');
			};

			layout();
			initCarousels(grid);
			observeVideos(grid);

			// Re-layout when the column count changes (debounced)
			let resizeTimer;
			window.addEventListener('resize', () => {
				clearTimeout(resizeTimer);
				resizeTimer = setTimeout(() => {
					if (columnCount() !== currentCols) layout();
				}, 150);
			});

			// ---- Infinite scroll: auto-load more posts when the sentinel appears ----
			if (sentinel && 'IntersectionObserver' in window) {
				const scrollObserver = new IntersectionObserver((entries) => {
					if (entries.some((e) => e.isIntersecting) && visibleCount < allItems.length) {
						revealMore();
					}
				}, { rootMargin: '400px 0px' });
				scrollObserver.observe(sentinel);
			} else if (sentinel) {
				// Fallback: no IntersectionObserver, just show everything
				revealMore();
				while (visibleCount < allItems.length) revealMore();
			}
		});
	</script>