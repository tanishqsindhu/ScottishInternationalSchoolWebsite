<% layout('layouts/boilerplate')%>
<section id="top" style="overflow: hidden" class="brand-hero row">
	<!--<iframe class="google-map" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3444.1434557992666!2d78.05572211552051!3d30.3184371125311!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390929b7249d5e1f%3A0x6a0dbc429180e02b!2sWelham%20Boys&#39;%20School!5e0!3m2!1sen!2sin!4v1594274963609!5m2!1sen!2sin"  frameborder="0" style="border:0;" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>-->
	<div class="animate-banner">
		<picture class="zoom">
			<div
				id="carouselExampleSlidesOnly"
				class="carousel slide carousel-fade"
				data-bs-ride="carousel"
				data-bs-pause="false"
			>
				<div class="carousel-inner">
					<div class="carousel-item active" data-bs-interval="3000">
						<img
							src="https://res.cloudinary.com/djfy7fvq1/image/upload//w_1500/q_auto/f_auto/v1683454348/Screenshot_2023-05-07_at_3.41.47_PM_wt8wpn.png"
							class="d-block w-100"
							alt="School Building"
							style="height: 70vh"
						/>
						<!-- <div class="carousel-caption d-none d-md-block">
                            <h5>First slide label</h5>
                            <p>Some representative placeholder content for the first slide.</p>
                        </div> -->
					</div>
					<div class="carousel-item" data-bs-interval="3000">
						<img
							src="https://res.cloudinary.com/djfy7fvq1/image/upload//w_1500/q_auto/f_auto/v1679174855/Scottish/qd8pkstxjoq0udwuwoc7.jpg"
							class="d-block w-100"
							alt="School Building"
							style="height: 70vh"
						/>
						<!-- <div class="carousel-caption d-none d-md-block">
                            <h5>First slide label</h5>
                            <p>Some representative placeholder content for the first slide.</p>
                        </div> -->
					</div>
				</div>
			</div>
		</picture>
	</div>
	<%- include('./partials/flash')%>
	<div class="page-title align-items-start">
		<div class="container">
			<div class="banner-content-inner">
				<h1>
					Gallery
					<a href="/"><i class="fa-solid fa-arrow-left" style="color: #eabd57"></i> Home</a>
				</h1>
			</div>
		</div>
	</div>
</section>
<svg xmlns="http://www.w3.org/2000/svg" class="d-none">
	<symbol id="info-fill" viewBox="0 0 16 16">
		<path
			d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"
		/>
	</symbol>
</svg>
<div class="container mt-4">
	<div class="row justify-content-center">
		<div
			class="alert alert-info alert-dismissible fade show d-flex align-items-center col-7"
			role="alert"
		>
			<svg class="bi flex-shrink-0 me-2" role="img" width="1rem" height="1rem" aria-label="Info:">
				<use xlink:href="#info-fill" />
			</svg>
			If Posts are not visible try turning off privacy settings or View on Chrome!
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	</div>
	<div class="row">
		<% posts.forEach(post=> { %>
		<div
			class="col-12 col-md-6 fb-post-container"
			data-aos="fade-up"
			style="max-width: 100%; height: auto; overflow: hidden"
		>
			<iframe
				class="fb-post"
				src="https://www.facebook.com/plugins/post.php?href=<%=post.url %>&show_text=true"
				style="border: none; min-width: 100%; height: 100vh; max-height: 100%"
				scrolling="no"
				frameborder="0"
				data-lazy="true"
				loading="lazy"
				allowfullscreen="true"
				allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
			>
			</iframe>
		</div>

		<% }); %>
	</div>
</div>
