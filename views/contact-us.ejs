							<div class="row">
								<div class="col">
									<address class="address-wrap">
										<h3 style="text-align: center; color: #654e42">Branch #1</h3>
										<div class="form-group">
											<i class="fa-solid fa-map-pin"></i>
											<p>
												<b>Location</b>
                                                <a
                                                href="https://maps.app.goo.gl/vJdQzYNjVQKK1eXSA"
                                                target="_blank"
                                                aria-label="maps link"
                                                rel="noopener noreferrer"
                                            >Scottish International School <br />Civil Line Police Station Rd, Sector 17,
												Hisar, Haryana 125005, India		</a>
											</p>
										</div>
										<div class="form-group">
											<i class="fa-solid fa-phone fa-shake"></i>
											<p>
												<b>Phone</b>
												<a href="tel:9315577788">+91-9315577788 </a>
												<!-- <a href="tel:+911352652935">2652935, </a><br> -->
											</p>
										</div>
										<div class="form-group">
											<i class="fa-solid fa-mobile-button fa-shake"></i>
											<p class="mb-0">
												<b>Admission Office</b>
												<a href="tel:9315577788">+91-9315577788</a>
											</p>
											<p>(09:30 AM to 06:00 PM)</p>
										</div>
										<div class="form-group">
											<i class="fa-solid fa-at fa-beat"></i>
											<p>
												<b>Email</b>
												<a href="mailto:scottishinternational@gmail.com" style="font-size: 12px"
													>scottishinternational@gmail.com</a
												>
											</p>
										</div>
									</address>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="col-md-5 col-xl-3 mt-3 mt-md-0">
					<div>
						<form
							class="border rounded shadow p-3 p-md-4 p-lg-5"
							action="/contact-us"
							method="post"
							style="background: var(--bs-body-bg)"
						>
							<h3 class="text-center mb-3">Contact us</h3>
							<div class="mb-3">
								<input class="form-control" type="text" name="user[name]" placeholder="Name" />
							</div>
							<div class="mb-3">
								<input class="form-control" type="email" name="user[email]" placeholder="Email" />
							</div>
							<div class="mb-3">
								<input
									class="form-control"
									type="number"
									name="user[mobilenumber]"
									placeholder="Phone Number"
								/>
							</div>
							<div class="mb-3">
								<textarea
									class="form-control"
									name="user[message]"
									placeholder="Message"
									rows="6"
								></textarea>
							</div>
							<div class="mb-3">
								<button class="btn btn-primary w-100" type="submit">Send</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
