	<script>
		document.addEventListener("DOMContentLoaded", function () {
			document.querySelectorAll(".collapseButton").forEach(function (btn) {
				btn.addEventListener("click", function (event) {
					let targetId = this.getAttribute("href");
					let targetCollapse = document.querySelector(targetId);

					// If the clicked collapse is not open, close all others first
					if (!targetCollapse.classList.contains("show")) {
						document.querySelectorAll(".collapse").forEach(function (collapse) {
							if (collapse !== targetCollapse) {
								collapse.classList.remove("show");
								let otherIcon = document.querySelector(`[href="#${collapse.id}"] .text-danger`);
								if (otherIcon) otherIcon.textContent = "+";
							}
						});
					}

					// Scroll to the clicked section smoothly when opening
					let offset = this.getBoundingClientRect().top + window.scrollY - 250; // Adjust 250px for better visibility
					window.scrollTo({ top: offset, behavior: "smooth" });
				});
			});

			// Listen for Bootstrap collapse events to toggle icon
			document.querySelectorAll(".collapse").forEach(function (collapse) {
				collapse.addEventListener("show.bs.collapse", function () {
					let btn = document.querySelector(`[href="#${this.id}"] .text-danger`);
					if (btn) btn.textContent = "-";
				});

				collapse.addEventListener("hidden.bs.collapse", function () {
					let btn = document.querySelector(`[href="#${this.id}"] .text-danger`);
					if (btn) btn.textContent = "+";
				});
			});
		});
	</script>
