<% layout('layouts/boilerplate')%>
    <div class="row">
        <div class="col">
            <div class="alert alert-danger" role="alert">
                <h1 class="alert-heading fs-4">Oops! Something went wrong (Error <%=err.message%>)</h1>
                <% if(process.env.NODE_ENV!=='production' ){ %>
                    <p>
                        <%= err.stack %>
                    </p>
                    <% } %>
                        <p>
                            You will be redirected to the previous page in 5 seconds.<a href="/"
                                class="btn col-12 mt-3 btn-outline-info">Go Home</a>
                        </p>
            </div>
        </div>
    </div>
    <% if(process.env.NODE_ENV==='production' ){ %>
        <script>
            // Function to redirect after 5 seconds
            function redirectToHome() {
                setTimeout(function () {
                    window.location.href = "<%= returnTo %>"; // Replace '/' with your home page URL if different
                }, 5000); // 5000 milliseconds = 5 seconds
            }

            // Call the function
            redirectToHome();
        </script>
        <% } %>