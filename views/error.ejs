<% layout('layouts/boilerplate')%>
<section id="top" class="brand-hero row">
	<!--<iframe class="google-map" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3444.1434557992666!2d78.05572211552051!3d30.3184371125311!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390929b7249d5e1f%3A0x6a0dbc429180e02b!2sWelham%20Boys&#39;%20School!5e0!3m2!1sen!2sin!4v1594274963609!5m2!1sen!2sin"  frameborder="0" style="border:0;" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>-->
	<div class="animate-banner">
		<picture class="zoom">
			<div
				id="carouselExampleSlidesOnly"
				class="carousel slide carousel-fade"
				data-bs-ride="carousel"
				data-bs-pause="false"
			>
				<div class="carousel-inner">
					<div class="carousel-item active" data-bs-interval="3000">
						<img
							src="https://res.cloudinary.com/djfy7fvq1/image/upload/w_1500/f_auto,q_auto/v1/Scottish/me8akbjwzvyuzno4e6zf"
							class="d-block w-100"
							alt="School Building"
							style="height: 70vh"
						/>
						<!-- <div class="carousel-caption d-none d-md-block">
                        <h5>First slide label</h5>
                        <p>Some representative placeholder content for the first slide.</p>
                    </div> -->
					</div>
					<div class="carousel-item" data-bs-interval="3000">
						<img
							src="https://res.cloudinary.com/djfy7fvq1/image/upload/w_1500/q_auto/f_auto/v1679174855/Scottish/qd8pkstxjoq0udwuwoc7"
							class="d-block w-100"
							alt="School Building"
							style="height: 70vh"
						/>
						<!-- <div class="carousel-caption d-none d-md-block">
                        <h5>First slide label</h5>
                        <p>Some representative placeholder content for the first slide.</p>
                    </div> -->
					</div>
				</div>
			</div>
		</picture>
	</div>
	<div class="page-title align-items-start">
		<div class="container">
			<div class="banner-content-inner">
				<h1>
					Error <a href="/"><i class="fa-solid fa-arrow-left" style="color: #eabd57"></i> Home</a>
				</h1>
			</div>
		</div>
	</div>
</section>
<div class="container-fluid">
	<div class="row m-5">
		<div class="col">
			<div class="alert alert-danger" role="alert">
				<h1 class="alert-heading fs-4">Oops! Something went wrong (Error <%=err.message%>)</h1>
				<% if(process.env.NODE_ENV!=='production' ){ %>
				<p><%= err.stack %></p>
				<% } %>
				<p>
					You will be redirected to the previous page in 5 seconds.<a
						href="/"
						class="btn col-12 mt-3 btn-outline-info"
						>Go Home</a
					>
				</p>
			</div>
		</div>
	</div>
</div>
<% if(process.env.NODE_ENV==='production' ){ %>
<script>
	// Function to redirect after 5 seconds
	function redirectToHome() {
		setTimeout(function () {
			window.location.href = "<%= returnTo %>"; // Replace '/' with your home page URL if different
		}, 5000); // 5000 milliseconds = 5 seconds
	}

	// Call the function
	redirectToHome();
</script>
<% } %>
<link rel="stylesheet" href="/stylesheets/contact-us.css" />
<link rel="stylesheet" href="/stylesheets/page-title.css" />
