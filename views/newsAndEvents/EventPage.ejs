<% layout('layouts/boilerplate')%>
        <section id="top" class="brand-hero row"style="overflow-x: hidden;">
            <div class="animate-banner">
                <picture class="zoom">
                    <div id="carouselExampleSlidesOnly" class="carousel slide carousel-fade" data-bs-ride="carousel"
                        data-bs-pause="false">
                        <div class="carousel-inner">
                            <div class="carousel-item active" data-bs-interval="3000">
                                <img src="https://res.cloudinary.com/djfy7fvq1/image/upload//w_1500/q_auto/f_auto/v1683454348/Screenshot_2023-05-07_at_3.41.47_PM_wt8wpn.png"
                                    class="d-block w-100" alt="building picture" style="height: 70vh;">
                                <!-- <div class="carousel-caption d-none d-md-block">
                        <h5>First slide label</h5>
                        <p>Some representative placeholder content for the first slide.</p>
                    </div> -->
                            </div>
                            <div class="carousel-item" data-bs-interval="3000">
                                <img src="https://res.cloudinary.com/djfy7fvq1/image/upload//w_1500/q_auto/f_auto/v1679174855/Scottish/qd8pkstxjoq0udwuwoc7.jpg"
                                    class="d-block w-100" alt="building picture" style="height: 70vh;">
                                <!-- <div class="carousel-caption d-none d-md-block">
                        <h5>First slide label</h5>
                        <p>Some representative placeholder content for the first slide.</p>
                    </div> -->
                            </div>
                        </div>
                    </div>
                </picture>
            </div>
            <div class="page-title align-items-start">
                <div class="container">
                    <div class="banner-content-inner">
                        <h1 style="font-size: 3em;">News And Events<a href="/news-events"><i
                                    class="fa-solid fa-arrow-left" style="color: #eabd57;"></i>
                                Back</a></h1>
                    </div>
                </div>
            </div>
        </section>
        <div class="container-fuild">
            <div class="row">
                <section class="inner-entry ">
                    <div class="container wow fadeInUp" data-wow-duration="1.5s" data-wow-delay=".2s"
                        style="visibility: visible; animation-duration: 1.5s; animation-delay: 0.2s; animation-name: fadeInUp;">
                        <div class="mainTitle">
                            <p class="title-branding mb-2"><img class="img-fluid"
                                    src="/assets/webp/SISTransparentLogoWhite.webp" alt="Logo"></p>
                            <!-- <h2>News And Events</h2> -->
                        </div>
                    </div>
                </section>
            </div>
        </div>
        <div class="page-content">
            <section class="profile-section">
                <div class="container-fuild">
                    <div class="row">
                        <div class="col-md-5 col-12 order-md-1">
                            <div class="profile-picture">
                                <div id="carouselExampleSlidesOnly" class="carousel slide carousel-fade"
                                    data-bs-ride="carousel" data-bs-pause="false">
                                    <div class="carousel-inner">
                                        <div class="carousel-item active" data-bs-interval="4000">
                                            <% if(news.images.length){ %>
                                                <img src="<%= news.images[0].url %>" class="d-block w-100"
                                                    alt="event photo" style="width: 100%;height: 100%;">
                                                <% }else{ %>
                                                    <img src="https://res.cloudinary.com/dlpq5gl1a/image/upload/v1688312952/No_image_Found_ioxitj.png"
                                                        class="d-block w-100" alt="event photo"
                                                        style="width: 100%;height: 100%;">
                                                    <% } %>
                                        </div>
                                        <% if(news.images.length>0) {%>
                                            <% for(let j=1;j<news.images.length;j++) {%>
                                                <div class="carousel-item">
                                                    <img src="<%= news.images[j].url %>" class="d-block w-100"
                                                        alt="event photo" style="width: 100%;height: 100%;">
                                                </div>
                                                <% } %>
                                                    <% } %>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <div class="col-md-7 col-12 order-md-2">
                            <div class="profile-content newsDetails style-section-3 pt-0">
                                <div class="text">
                                    <div class="content-text ImgNotFound mt-3 mt-md-0 me-0">
                                        <h3 class="title-medium"><small>News</small>
                                            <%= news.title %> <b class="date"><i
                                                        class="fa-regular fa-clock fa-fade"></i>
                                                    <%= news.date %>
                                                        <%= news.month %>
                                                            <%= news.year %>
                                                </b>
                                        </h3>

                                        <div class="text readMoreText ">
                                            <p></p>

                                            <div data-aos="fade-up">
                                                <%=news.paragraph1 %>.
                                            </div>
                                            <div>&nbsp;</div>
                                            <% if(news.paragraph2!='' ){ %>
                                                <div data-aos="fade-up">
                                                    <%=news.paragraph2 %>.
                                                </div>
                                                <div>&nbsp;</div>
                                                <% } %>
                                                    <% if(news.paragraph3!='' ){ %>
                                                        <div data-aos="fade-up">
                                                            <%=news.paragraph3 %>.
                                                        </div>
                                                        <div>&nbsp;</div>
                                                        <% } %>
                                                            <% if(news.paragraph4!='' ){ %>
                                                                <div data-aos="fade-up">
                                                                    <%=news.paragraph4 %>.&nbsp;
                                                                </div>
                                                                <div data-aos="fade-up">&nbsp;</div>
                                                                <% } %>
                                                                    <% if(news.paragraph5!='' ){ %>
                                                                        <div data-aos="fade-up">
                                                                            <%=news.paragraph5 %>.
                                                                        </div>
                                                                        <% } %>
                                                                            <p></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% if(currentUser) {%>
                                <% if(currentUser.role.includes('articlesEditor')) {%>
                                    <span>
                                        <a class="btn btn-outline-info " href="/news-events/<%=news._id%>/edit">Edit</a>
                                        <form class="d-inline-block" action="/news-events/<%=news._id%>?_method=DELETE"
                                            method="POST">
                                            <button type="submit"
                                                class="btn btn-block btn-outline-danger col">Delete</button>
                                        </form>
                                    </span>
                                    <% } %>
                                        <% } %>
                        </div>
                    </div>
                </div>
            </section>
        </div>
        <link rel="stylesheet" href="/stylesheets/eventPage.css">
        <link rel="stylesheet" href="/stylesheets/page-title.css">