<% layout('layouts/boilerplate')%>
<section id="top" class="brand-hero row" style="overflow-x: hidden">
	<div class="animate-banner">
		<picture class="zoom">
			<div
				id="carouselExampleSlidesOnly"
				class="carousel slide carousel-fade"
				data-bs-ride="carousel"
				data-pause="false"
			>
				<div class="carousel-inner">
					<div class="carousel-item active" data-bs-interval="3000">
						<img
							src="https://res.cloudinary.com/djfy7fvq1/image/upload/w_1500/f_auto,q_auto/v1/Scottish/me8akbjwzvyuzno4e6zf"
							class="d-block w-100"
							alt="School Building"
							style="height: 70vh"
						/>
						<!-- <div class="carousel-caption d-none d-md-block">
                        <h5>First slide label</h5>
                        <p>Some representative placeholder content for the first slide.</p>
                    </div> -->
					</div>
					<div class="carousel-item" data-bs-interval="3000">
						<img
							src="https://res.cloudinary.com/djfy7fvq1/image/upload/w_1500/q_auto/f_auto/v1741596937/naqc1fiijnhbap3jmyr8.webp"
							class="d-block w-100"
							alt="School Building"
							style="height: 70vh"
						/>
						<!-- <div class="carousel-caption d-none d-md-block">
                        <h5>First slide label</h5>
                        <p>Some representative placeholder content for the first slide.</p>
                    </div> -->
					</div>
				</div>
			</div>
		</picture>
	</div>
	<div class="page-title align-items-start">
		<div class="container">
			<div class="banner-content-inner">
				<h1 style="font-size: 3em">
					News And Events<a href="/news-events"
						><i class="fa-solid fa-arrow-left" style="color: #eabd57"></i> Back</a
					>
				</h1>
			</div>
		</div>
	</div>
</section>
<div class="container-fuild">
	<div class="row">
		<section class="inner-entry">
			<div
				class="container wow fadeInUp"
				data-wow-duration="1.5s"
				data-wow-delay=".2s"
				style="
					visibility: visible;
					animation-duration: 1.5s;
					animation-delay: 0.2s;
					animation-name: fadeInUp;
				"
			>
				<div class="mainTitle">
					<p class="title-branding mb-2">
						<img class="img-fluid" src="/assets/webp/SISTransparentLogoWhite.webp" alt="Logo" />
					</p>
					<h2>Add New Article</h2>
				</div>
			</div>
		</section>
	</div>
</div>
<div class="container mt-5">
	<div class="row card shadow mb-5">
		<div>
			<div class="card-body">
				<div class="col-md-6 offset-md-3">
					<div class="alert alert-warning" role="alert">
						First image selected in time of uploading will act as a thumbnail for the article.
					</div>

					<form
						action="/news-events/add"
						method="POST"
						novalidate
						class="validated-form"
						enctype="multipart/form-data"
					>
						<div class="mb-3">
							<label class="form-label" for="title">Title: </label>
							<input class="form-control" type="text" id="title" name="article[title]" required />
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="secondaryTitle">Secondary Title:</label>
							<input
								class="form-control"
								type="text"
								id="secondaryTitle"
								name="article[secondaryTitle]"
								required
							/>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label for="image" class="form-label">Images</label>
							<input class="form-control" type="file" id="image" name="image" multiple required />
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="date">Date:</label>
							<input class="form-control" type="number" id="day" name="article[date]" required />
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="month">Month:</label>
							<select class="form-select" id="class" name="article[month]" required>
								<option selected>Choose...</option>
								<option value="Jan">January</option>
								<option value="Feb">February</option>
								<option value="Mar">March</option>
								<option value="Apr">April</option>
								<option value="May">May</option>
								<option value="Jun">June</option>
								<option value="Jul">July</option>
								<option value="Aug">August</option>
								<option value="Sept">September</option>
								<option value="Oct">October</option>
								<option value="Nov">November</option>
								<option value="Dec">December</option>
							</select>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="year">Year:</label>
							<input class="form-control" type="number" id="year" name="article[year]" required />
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="shortDescription"
								>Short Description(10 to 20 Words):
							</label>
							<input
								class="form-control"
								type="text"
								id="shortDescription"
								name="article[shortDescription]"
								required
							/>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="title">Title: </label>
							<input class="form-control" type="text" id="title" name="article[title]" required />
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="paragraph1">Paragraph 1: </label>
							<input
								class="form-control"
								type="text"
								id="paragraph1"
								name="article[paragraph1]"
								required
							/>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="title">Paragraph 2 Title(optional): </label>
							<input
								class="form-control"
								type="text"
								id="title"
								name="article[paragraph2title]"
								required
							/>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="paragraph2">Paragraph 2 (optional): </label>
							<input class="form-control" type="text" id="paragraph2" name="article[paragraph2]" />
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="title">Paragraph 3 Title(optional): </label>
							<input
								class="form-control"
								type="text"
								id="title"
								name="article[paragraph3title]"
								required
							/>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="paragraph3">Paragraph 3 (optional): </label>
							<input class="form-control" type="text" id="paragraph3" name="article[paragraph3]" />
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="title">Paragraph 4 Title(optional): </label>
							<input
								class="form-control"
								type="text"
								id="title"
								name="article[paragraph4title]"
								required
							/>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="paragraph4">Paragraph 4 (optional): </label>
							<input class="form-control" type="text" id="paragraph4" name="article[paragraph4]" />
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="title">Paragraph 5 Title(optional): </label>
							<input
								class="form-control"
								type="text"
								id="title"
								name="article[paragraph5title]"
								required
							/>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label" for="paragraph5">Paragraph 5 (optional): </label>
							<input class="form-control" type="text" id="paragraph5" name="article[paragraph5]" />
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<button class="btn btn-outline-success w-100">Add Article</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
	<a href="/news-events" class="btn btn-outline-info col-12">View All News And Events</a>
</div>

<link rel="stylesheet" href="/stylesheets/page-title.css" />
