				data-bs-ride="carousel"
				data-pause="false"
			>
				<div class="carousel-inner">
					<div class="carousel-item active" data-bs-interval="3000">
						<img
							src="https://res.cloudinary.com/djfy7fvq1/image/upload/w_1500/f_auto,q_auto/v1/Scottish/me8akbjwzvyuzno4e6zf"
							class="d-block w-100"
							alt="School Building"
							style="height: 70vh"
						/>
						<!-- <div class="carousel-caption d-none d-md-block">
                        <h5>First slide label</h5>
                        <p>Some representative placeholder content for the first slide.</p>
                    </div> -->
					</div>
					<div class="carousel-item" data-bs-interval="3000">
						<img
							src="https://res.cloudinary.com/djfy7fvq1/image/upload/w_1500/q_auto/f_auto/v1741596937/naqc1fiijnhbap3jmyr8.webp"
							class="d-block w-100"
							alt="School Building"
							style="height: 70vh"
						/>
						<!-- <div class="carousel-caption d-none d-md-block">
                        <h5>First slide label</h5>
                        <p>Some representative placeholder content for the first slide.</p>
                    </div> -->
					</div>
				</div>
			</div>
		</picture>
	</div>
	<div class="page-title align-items-start">
		<div class="container">
			<div class="banner-content-inner">
				<h1 style="font-size: 3em">
					News And Events<a href="/news-events"
						><i class="fa-solid fa-arrow-left" style="color: #eabd57"></i> Back</a
					>
				</h1>
			</div>
		</div>
	</div>
</section>
<div class="container-fuild">
	<div class="row">
		<section class="inner-entry">
			<div
				class="container wow fadeInUp"
				data-wow-duration="1.5s"
				data-wow-delay=".2s"
				style="
					visibility: visible;
					animation-duration: 1.5s;
					animation-delay: 0.2s;
					animation-name: fadeInUp;
				"
			>
				<div class="mainTitle">
					<p class="title-branding mb-2">
						<img class="img-fluid" src="/assets/webp/SISTransparentLogoWhite.webp" alt="Logo" />
					</p>
					<h2>Add New Article</h2>
				</div>
			</div>
		</section>
	</div>
</div>
<link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css" />
<div class="container mt-5">
	<div class="row card shadow mb-5">
		<div>
			<div class="card-body">
				<div class="col-md-8 offset-md-2">
					<div class="alert alert-warning" role="alert">
						First image selected in time of uploading will act as a thumbnail for the article.
					</div>

					<form
						action="/news-events/add"
						method="POST"
						novalidate
						class="validated-form"
						enctype="multipart/form-data"
						id="articleForm"
					>
						<div class="mb-3">
							<label class="form-label fw-bold" for="title">Title</label>
							<input class="form-control" type="text" id="title" name="article[title]" required placeholder="Enter article title" />
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold" for="secondaryTitle">Secondary Title</label>
							<input
								class="form-control"
								type="text"
								id="secondaryTitle"
								name="article[secondaryTitle]"
								required
								placeholder="Enter a subtitle or tagline"
							/>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label for="image" class="form-label fw-bold">Images</label>
							<input class="form-control" type="file" id="image" name="image" multiple required accept="image/*" />
							<small class="text-muted">You can select multiple images. The first image will be used as the thumbnail.</small>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="row mb-3">
							<div class="col-md-4">
								<label class="form-label fw-bold" for="day">Date</label>
								<input class="form-control" type="number" id="day" name="article[date]" required min="1" max="31" placeholder="DD" />
							</div>
							<div class="col-md-4">
								<label class="form-label fw-bold" for="month">Month</label>
								<select class="form-select" id="month" name="article[month]" required>
									<option value="" selected disabled>Choose...</option>
									<option value="Jan">January</option>
									<option value="Feb">February</option>
									<option value="Mar">March</option>
									<option value="Apr">April</option>
									<option value="May">May</option>
									<option value="Jun">June</option>
									<option value="Jul">July</option>
									<option value="Aug">August</option>
									<option value="Sept">September</option>
									<option value="Oct">October</option>
									<option value="Nov">November</option>
									<option value="Dec">December</option>
								</select>
							</div>
							<div class="col-md-4">
								<label class="form-label fw-bold" for="year">Year</label>
								<input class="form-control" type="number" id="year" name="article[year]" required placeholder="YYYY" />
							</div>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold" for="shortDescription">Short Description</label>
							<textarea
								class="form-control"
								id="shortDescription"
								name="article[shortDescription]"
								required
								rows="2"
								maxlength="200"
								placeholder="Brief summary of the article (10-20 words)"
							></textarea>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold" for="author">Author</label>
							<input class="form-control" type="text" id="author" name="article[author]" placeholder="Author name (optional)" />
						</div>
						<div class="mb-4">
							<label class="form-label fw-bold">Article Content</label>
							<div id="editor" style="min-height: 300px;"></div>
							<input type="hidden" name="article[content]" id="articleContent" />
						</div>
						<div class="mb-3">
							<button type="submit" class="btn btn-outline-success w-100 btn-lg">Add Article</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
	<a href="/news-events" class="btn btn-outline-info col-12 mb-4">View All News And Events</a>
</div>

<link rel="stylesheet" href="/stylesheets/page-title.css" />

<style>
	#editor .ql-editor { font-size: 16px; line-height: 1.8; }
	#editor .ql-editor h1 { font-size: 1.8em; color: #980505; }
	#editor .ql-editor h2 { font-size: 1.5em; color: #980505; }
	#editor .ql-editor h3 { font-size: 1.25em; }
	.ql-toolbar.ql-snow { border-radius: 6px 6px 0 0; background: #f8f9fa; }
	.ql-container.ql-snow { border-radius: 0 0 6px 6px; }
</style>

<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
	document.addEventListener('DOMContentLoaded', function() {
		var quill = new Quill('#editor', {
			theme: 'snow',
			placeholder: 'Write your article content here...',
			modules: {
				toolbar: [
					[{ 'header': [1, 2, 3, false] }],
					['bold', 'italic', 'underline', 'strike','link'],
					[{ 'color': [] }, { 'background': [] }],
					[{ 'align': [] },{ 'indent': '-1' }, { 'indent': '+1' }],
					[{ 'list': 'ordered'}, { 'list': 'bullet' }],
					['blockquote','code-block'],
					['clean']
				]
			}
		});

		document.getElementById('articleForm').addEventListener('submit', function() {
			var content = quill.root.innerHTML;
			if (content === '<p><br></p>') content = '';
			document.getElementById('articleContent').value = content;
		});
	});
</script>
