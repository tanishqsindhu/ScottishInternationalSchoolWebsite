			<div
				id="carouselExampleSlidesOnly"
				class="carousel slide carousel-fade"
				data-bs-ride="carousel"
				data-bs-pause="false"
			>
				<div class="carousel-inner">
					<div class="carousel-item active" data-bs-interval="3000">
						<img
							src="https://res.cloudinary.com/djfy7fvq1/image/upload/w_1500/f_auto,q_auto/v1/Scottish/me8akbjwzvyuzno4e6zf"
							class="d-block w-100"
							alt="School Building"
							style="height: 70vh"
						/>
						<!-- <div class="carousel-caption d-none d-md-block">
                        <h5>First slide label</h5>
                        <p>Some representative placeholder content for the first slide.</p>
                    </div> -->
					</div>
					<div class="carousel-item" data-bs-interval="3000">
						<img
							src="https://res.cloudinary.com/djfy7fvq1/image/upload/w_1500/q_auto/f_auto/v1741596937/naqc1fiijnhbap3jmyr8.webp"
							class="d-block w-100"
							alt="School Building"
							style="height: 70vh"
						/>
						<!-- <div class="carousel-caption d-none d-md-block">
                        <h5>First slide label</h5>
                        <p>Some representative placeholder content for the first slide.</p>
                    </div> -->
					</div>
				</div>
			</div>
		</picture>
	</div>
	<div class="page-title align-items-start">
		<div class="container">
			<div class="banner-content-inner">
				<h1 style="font-size: 3em">
					News And Events<a href="/news-events/<%=news._id%>"
						><i class="fa-solid fa-arrow-left" style="color: #eabd57"></i> Back</a
					>
				</h1>
			</div>
		</div>
	</div>
</section>
<div class="container-fuild">
	<div class="row">
		<section class="inner-entry">
			<div
				class="container wow fadeInUp"
				data-wow-duration="1.5s"
				data-wow-delay=".2s"
				style="
					visibility: visible;
					animation-duration: 1.5s;
					animation-delay: 0.2s;
					animation-name: fadeInUp;
				"
			>
				<div class="mainTitle">
					<p class="title-branding mb-2">
						<img class="img-fluid" src="/assets/webp/SISTransparentLogoWhite.webp" alt="Logo" />
					</p>
					<h2>Update The Article</h2>
				</div>
			</div>
		</section>
	</div>
</div>
<link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css" />
<div class="container mt-5">
	<div class="row card shadow mb-5">
		<div>
			<div class="card-body">
				<div class="col-md-8 offset-md-2">
					<div class="alert alert-warning" role="alert">
						First image selected in time of uploading will act as a thumbnail for the article.
					</div>

					<form
						action="/news-events/<%=news._id%>?_method=PUT"
						method="POST"
						novalidate
						class="validated-form"
						enctype="multipart/form-data"
						id="articleForm"
					>
						<div class="mb-3">
							<label class="form-label fw-bold" for="title">Title</label>
							<input
								class="form-control"
								type="text"
								id="title"
								name="article[title]"
								required
								value="<%=news.title%>"
							/>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold" for="secondaryTitle">Secondary Title</label>
							<input
								class="form-control"
								type="text"
								id="secondaryTitle"
								name="article[secondaryTitle]"
								value="<%=news.secondaryTitle%>"
								required
							/>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label for="image" class="form-label fw-bold">Add More Images</label>
							<input class="form-control" type="file" id="image" name="image" multiple accept="image/*" />
							<small class="text-muted">Select additional images to add. The first image will be used as the thumbnail.</small>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="row mb-3">
							<div class="col-md-4">
								<label class="form-label fw-bold" for="day">Date</label>
								<input
									class="form-control"
									type="number"
									id="day"
									name="article[date]"
									value="<%=news.date%>"
									required
									min="1"
									max="31"
									placeholder="DD"
								/>
							</div>
							<div class="col-md-4">
								<label class="form-label fw-bold" for="month">Month</label>
								<select class="form-select" id="month" name="article[month]" required>
									<option value="Jan" <%= news.month === 'Jan' ? 'selected' : '' %>>January</option>
									<option value="Feb" <%= news.month === 'Feb' ? 'selected' : '' %>>February</option>
									<option value="Mar" <%= news.month === 'Mar' ? 'selected' : '' %>>March</option>
									<option value="Apr" <%= news.month === 'Apr' ? 'selected' : '' %>>April</option>
									<option value="May" <%= news.month === 'May' ? 'selected' : '' %>>May</option>
									<option value="Jun" <%= news.month === 'Jun' ? 'selected' : '' %>>June</option>
									<option value="Jul" <%= news.month === 'Jul' ? 'selected' : '' %>>July</option>
									<option value="Aug" <%= news.month === 'Aug' ? 'selected' : '' %>>August</option>
									<option value="Sept" <%= news.month === 'Sept' ? 'selected' : '' %>>September</option>
									<option value="Oct" <%= news.month === 'Oct' ? 'selected' : '' %>>October</option>
									<option value="Nov" <%= news.month === 'Nov' ? 'selected' : '' %>>November</option>
									<option value="Dec" <%= news.month === 'Dec' ? 'selected' : '' %>>December</option>
								</select>
							</div>
							<div class="col-md-4">
								<label class="form-label fw-bold" for="year">Year</label>
								<input
									class="form-control"
									type="number"
									id="year"
									name="article[year]"
									value="<%=news.year%>"
									required
									placeholder="YYYY"
								/>
							</div>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold" for="shortDescription">Short Description</label>
							<textarea
								class="form-control"
								id="shortDescription"
								name="article[shortDescription]"
								required
								rows="2"
								maxlength="200"
								placeholder="Brief summary of the article (10-20 words)"
							><%= news.shortDescription %></textarea>
							<div class="valid-feedback">Looks good!</div>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold" for="author">Author</label>
							<input class="form-control" type="text" id="author" name="article[author]" value="<%= news.author || '' %>" placeholder="Author name (optional)" />
						</div>
						<div class="mb-4">
							<label class="form-label fw-bold">Article Content</label>
							<div id="editor" style="min-height: 300px;"><% if(news.content) { %><%- news.content %><% } else { %><% if(news.paragraph1) { %><p><%= news.paragraph1 %></p><% } %><% if(news.paragraph2title) { %><h2><%= news.paragraph2title %></h2><% } %><% if(news.paragraph2) { %><p><%= news.paragraph2 %></p><% } %><% if(news.paragraph3title) { %><h2><%= news.paragraph3title %></h2><% } %><% if(news.paragraph3) { %><p><%= news.paragraph3 %></p><% } %><% if(news.paragraph4title) { %><h2><%= news.paragraph4title %></h2><% } %><% if(news.paragraph4) { %><p><%= news.paragraph4 %></p><% } %><% if(news.paragraph5title) { %><h2><%= news.paragraph5title %></h2><% } %><% if(news.paragraph5) { %><p><%= news.paragraph5 %></p><% } %><% } %></div>
							<input type="hidden" name="article[content]" id="articleContent" />
						</div>
						<% if(news.images && news.images.length) { %>
						<div class="mb-4">
							<label class="form-label fw-bold">Current Images</label>
							<div class="row g-3">
								<% news.images.forEach(function(img, i) { %>
								<div class="col-6 col-md-3">
									<div class="card h-100">
										<img src="<%=img.thumbnail %>" class="card-img-top" alt="Article image" />
										<div class="card-body text-center p-2">
											<div class="form-check">
												<input
													class="form-check-input"
													type="checkbox"
													id="image-<%=i%>"
													name="deleteImages[]"
													value="<%=img.filename%>"
												/>
												<label class="form-check-label text-danger" for="image-<%=i%>">Delete</label>
											</div>
										</div>
									</div>
								</div>
								<% }) %>
							</div>
						</div>
						<% } %>
						<div class="mb-3">
							<button type="submit" class="btn btn-outline-success w-100 btn-lg">Update Article</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
	<a href="/news-events" class="btn btn-outline-info col-12 mb-4">View All News And Events</a>
</div>

<link rel="stylesheet" href="/stylesheets/page-title.css" />

<style>
	#editor .ql-editor { font-size: 16px; line-height: 1.8; }
	#editor .ql-editor h1 { font-size: 1.8em; color: #980505; }
	#editor .ql-editor h2 { font-size: 1.5em; color: #980505; }
	#editor .ql-editor h3 { font-size: 1.25em; }
	.ql-toolbar.ql-snow { border-radius: 6px 6px 0 0; background: #f8f9fa; }
	.ql-container.ql-snow { border-radius: 0 0 6px 6px; }
</style>

<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
	document.addEventListener('DOMContentLoaded', function() {
		var quill = new Quill('#editor', {
			theme: 'snow',
			placeholder: 'Write your article content here...',
			modules: {
				toolbar: [
					[{ 'header': [1, 2, 3, false] }],
					['bold', 'italic', 'underline', 'strike'],
					[{ 'color': [] }, { 'background': [] }],
					[{ 'align': [] }],
					[{ 'list': 'ordered'}, { 'list': 'bullet' }],
					['blockquote'],
					['link'],
					['clean']
				]
			}
		});

		document.getElementById('articleForm').addEventListener('submit', function() {
			var content = quill.root.innerHTML;
			if (content === '<p><br></p>') content = '';
			document.getElementById('articleContent').value = content;
		});
	});
</script>
